@page
@model TRM.Pages.UserManagementModel
@{
    ViewData["Title"] = "User Management";
    ViewData["Active"] = "users";
    Layout = "~/Pages/Shared/_LayoutDashboard.cshtml";

    // Deterministic avatar colors, keyed off each user's id so the same
    // person always gets the same color across page loads.
    var avatarPalette = new[]
    {
        "linear-gradient(135deg, #6366F1 0%, #4338CA 100%)",
        "linear-gradient(135deg, #F59E0B 0%, #B45309 100%)",
        "linear-gradient(135deg, #10B981 0%, #047857 100%)",
        "linear-gradient(135deg, #EC4899 0%, #BE185D 100%)",
        "linear-gradient(135deg, #06B6D4 0%, #0E7490 100%)",
        "linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%)",
    };
}

<header class="dashboard-header shadow-md border-b-2 border-blue-50">
    <div class="header-content">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">User Management</h1>
        <p class="text-gray-600 font-medium">Manage system users, roles, and access levels.</p>
    </div>
    <div class="header-actions">
        <button type="button" class="btn-new-request hover:shadow-lg transition-all duration-300 ease-out" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Add User
        </button>
    </div>
</header>

<div class="dashboard-content bg-gradient-to-b from-slate-50 to-white rounded-b-2xl">
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show animate-slide-down" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- User Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-users hover:shadow-2xl cursor-pointer">
            <div class="stat-icon user-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-value text-indigo-600 font-bold">@Model.Statistics.TotalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>

        <div class="stat-card stat-active hover:shadow-2xl cursor-pointer">
            <div class="stat-icon active-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-value text-green-600 font-bold">@Model.Statistics.ActiveUsers</div>
                <div class="stat-label">Active</div>
            </div>
        </div>

        <div class="stat-card stat-inactive hover:shadow-2xl cursor-pointer">
            <div class="stat-icon inactive-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-value text-red-600 font-bold">@Model.Statistics.InactiveUsers</div>
                <div class="stat-label">Inactive</div>
            </div>
        </div>

        <div class="stat-card stat-admins hover:shadow-2xl cursor-pointer">
            <div class="stat-icon admin-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-value text-purple-600 font-bold">@Model.Statistics.AdminUsers</div>
                <div class="stat-label">Admins</div>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg max-w-3xl mx-auto">
        <div class="modal-content bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="modal-header flex items-center justify-between p-4 border-b">
                <div class="modal-title-section flex items-center gap-3">
                    <div class="text-indigo-600 bg-indigo-50 rounded-full p-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <h5 id="editUserModalLabel" class="text-lg font-semibold">Edit User</h5>
                </div>
                <button type="button" class="btn-close text-gray-500 hover:bg-gray-100 rounded p-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-page-handler="Update" id="editUserForm">
                <input type="hidden" name="userId" id="editUserId" />
                <div class="modal-body p-6 bg-gray-50">
                    <div class="modal-avatar-row flex items-center gap-4 mb-4">
                        <div class="avatar-preview w-12 h-12 rounded-full flex items-center justify-center text-white font-semibold" id="editAvatarPreview">?</div>
                        <div class="avatar-hint text-sm text-gray-500">Avatar initials are generated automatically from the full name.</div>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group-modal">
                        <label class="form-label">Full Name</label>
                        <div class="input-wrapper">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input type="text" class="form-control" id="editEmployeeName" name="NewUser.EmployeeName" placeholder="Enter full name" value="@(Model.NewUser?.EmployeeName ?? String.Empty)" required />
                        </div>
                    </div>

                    <!-- Username and Password Row -->
                    <div class="form-row">
                        <div class="form-group-modal">
                            <label class="form-label">UserID</label>
                            <div class="input-wrapper">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <input type="text" class="form-control" id="editUserUserId" name="NewUser.UserId" placeholder="Enter user ID" value="@(Model.NewUser?.UserId ?? String.Empty)" required />
                            </div>
                        </div>

                        <div class="form-group-modal">
                            <label class="form-label">Password (leave blank to keep current)</label>
                            <div class="input-wrapper">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <input type="password" class="form-control" id="editPassword" name="NewUser.Password" placeholder="••••••••" autocomplete="new-password" />
                                <button type="button" class="input-action-btn" id="editTogglePasswordBtn" title="Show password" aria-label="Show password">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-group-modal">
                        <label class="form-label">Email</label>
                        <div class="input-wrapper">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                            <input type="email" class="form-control" id="editEmail" name="NewUser.Email" placeholder="Enter email address" value="@(Model.NewUser?.Email ?? String.Empty)" required />
                        </div>
                    </div>

                    <!-- Department -->
                    <div class="form-group-modal">
                        <label class="form-label" for="editDepartment">Department</label>
                        <div class="input-wrapper">
                            <select class="form-control" id="editDepartment" name="NewUser.Department" required>
                                <option value="">Select a department</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department">@department</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Access Level Selection -->
                    <div class="form-group-modal">
                        <label class="form-label">Access Level</label>
                        <div class="access-level-selector">
                            <div class="role-option">
                                <input type="radio" id="editRoleAdmin" name="NewUser.Role" value="Admin" @(Model.NewUser?.Role == "Admin" ? "checked" : "") />
                                <label for="editRoleAdmin" class="role-option-label admin px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Admin" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon admin">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Admin</span>
                                        <span class="role-description">Full system access</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="editRoleApprover" name="NewUser.Role" value="Approver" @(Model.NewUser?.Role == "Approver" ? "checked" : "") />
                                <label for="editRoleApprover" class="role-option-label approver px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Approver" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon approver">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 3l8 4v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V7l8-4z"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Approver</span>
                                        <span class="role-description">Approve &amp; manage requests</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="editRoleEncoder" name="NewUser.Role" value="Encoder" @(Model.NewUser?.Role == "Encoder" ? "checked" : "") />
                                <label for="editRoleEncoder" class="role-option-label encoder @(Model.NewUser?.Role == "Encoder" ? "selected" : "")">
                                    <span class="role-icon encoder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Encoder</span>
                                        <span class="role-description">Create &amp; edit records</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="editRoleViewer" name="NewUser.Role" value="Viewer" @(Model.NewUser?.Role == "Viewer" ? "checked" : "") />
                                <label for="editRoleViewer" class="role-option-label viewer px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Viewer" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon viewer">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Viewer</span>
                                        <span class="role-description">Read-only access</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Account Status -->
                    <div class="form-group-modal account-status">
                        <div>
                            <div class="form-label">Account Status</div>
                            <div class="status-hint">Toggle to activate or deactivate the account.</div>
                        </div>
                        <div class="status-toggle">
                            <input type="checkbox" id="editIsActive" name="NewUser.IsActive" value="true" />
                            <input type="hidden" name="NewUser.IsActive" value="false" />
                            <label for="editIsActive" class="toggle-label" id="editIsActiveLabel">Active</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer flex items-center justify-end gap-3 p-4 border-t bg-white">
                    <button type="button" data-bs-dismiss="modal" class="bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-md">Cancel</button>
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-md">Update User</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <!-- Access Levels Section -->
    <div class="access-levels-section">
        <h3 class="text-sm font-bold uppercase text-gray-500 tracking-widest mb-4 flex items-center gap-2">
            <span class="w-1 h-5 bg-gradient-to-b from-blue-500 to-purple-500 rounded-full"></span>
            ACCESS LEVELS
        </h3>
        <div class="access-level-grid">
            <div class="access-level-card hover:shadow-lg hover:border-purple-400 cursor-pointer" data-access-role="admin" role="button" tabindex="0" aria-pressed="false" aria-label="Filter users by Admin access">
                <div class="role-icon admin">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div class="role-info">
                    <div class="role-name font-semibold text-gray-800">Admin</div>
                    <div class="role-desc text-xs text-gray-500">Full system access</div>
                </div>
            </div>

            <div class="access-level-card hover:shadow-lg hover:border-blue-400 cursor-pointer" data-access-role="approver" role="button" tabindex="0" aria-pressed="false" aria-label="Filter users by Approver access">
                <div class="role-icon manager">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="8"/><path d="M16 13h7M19 10v6M22.5 13h-7"/></svg>
                </div>
                <div class="role-info">
                    <div class="role-name font-semibold text-gray-800">Approver</div>
                    <div class="role-desc text-xs text-gray-500">Approve & manage requests</div>
                </div>
            </div>

            <div class="access-level-card hover:shadow-lg hover:border-yellow-400 cursor-pointer" data-access-role="encoder" role="button" tabindex="0" aria-pressed="false" aria-label="Filter users by Encoder access">
                <div class="role-icon encoder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                </div>
                <div class="role-info">
                    <div class="role-name font-semibold text-gray-800">Encoder</div>
                    <div class="role-desc text-xs text-gray-500">Create & edit records</div>
                </div>
            </div>

            <div class="access-level-card hover:shadow-lg hover:border-gray-400 cursor-pointer" data-access-role="viewer" role="button" tabindex="0" aria-pressed="false" aria-label="Filter users by Viewer access">
                <div class="role-icon viewer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <div class="role-info">
                    <div class="role-name font-semibold text-gray-800">Viewer</div>
                    <div class="role-desc text-xs text-gray-500">Read-only access</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar: search + filters -->
    <div class="table-toolbar shadow-sm hover:shadow-md transition-shadow duration-300 rounded-xl border border-gray-100">
        <div class="search-input-wrapper bg-white rounded-lg shadow-sm p-2 flex items-center gap-3 border border-gray-200 hover:border-blue-300 focus-within:border-blue-500 focus-within:shadow-md transition-all duration-300">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-400">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text" class="search-input flex-1 outline-none text-sm text-gray-700 placeholder-gray-400" id="searchInput" placeholder="Search by name, email, username, or department..." autocomplete="off" />
        </div>

        <div class="status-pills flex gap-2 flex-wrap">
            <button type="button" class="status-pill active bg-blue-50 text-blue-600 font-semibold px-4 py-2 rounded-full hover:bg-blue-100 transition-all duration-200" data-status="all">All Status</button>
            <button type="button" class="status-pill bg-gray-100 text-gray-600 font-semibold px-4 py-2 rounded-full hover:bg-gray-200 hover:text-gray-900 transition-all duration-200" data-status="active">Active</button>
            <button type="button" class="status-pill bg-gray-100 text-gray-600 font-semibold px-4 py-2 rounded-full hover:bg-gray-200 hover:text-gray-900 transition-all duration-200" data-status="inactive">Inactive</button>
        </div>

        <div class="toolbar-divider"></div>

        <select class="filter-select" id="roleFilter">
            <option value="all">All Roles</option>
            <option value="admin">Admin</option>
            <option value="approver">Approver</option>
            <option value="encoder">Encoder</option>
            <option value="viewer">Viewer</option>
        </select>
    </div>

    <!-- Users Table -->
    <div class="users-table-wrapper">
        <div class="users-table-scroll">
            <div class="users-table-header">
                <div class="header-cell user-name-col">
                    <button type="button" class="th-btn" data-sort="name">User <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell email-col">
                    <button type="button" class="th-btn" data-sort="email">Email <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell department-col">
                    <button type="button" class="th-btn" data-sort="department">Department <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell role-col">
                    <button type="button" class="th-btn" data-sort="role">Role <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell last-login-col">
                    <button type="button" class="th-btn" data-sort="login">Last Login <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell status-col">
                    <button type="button" class="th-btn" data-sort="status">Status <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
                </div>
                <div class="header-cell actions-col">Actions</div>
            </div>

            @if (Model.Users != null && Model.Users.Count > 0)
            {
                @foreach (var user in Model.Users)
                {
                    var initials = string.Join("", (user.EmployeeName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => char.ToUpper(w[0]))).PadRight(1, '?');
                    if (initials.Length > 2) { initials = initials.Substring(0, 2); }
                    var avatarColor = avatarPalette[Math.Abs(user.Id) % avatarPalette.Length];
                    var roleClass = (user.Role ?? "viewer").ToLower();

                    string lastLoginDisplay = "Never";
                    string lastLoginTitle = "";
                    if (user.LastLogin.HasValue)
                    {
                        var span = DateTime.Now - user.LastLogin.Value;
                        lastLoginTitle = user.LastLogin.Value.ToString("MMM d, yyyy 'at' h:mm tt");
                        if (span.TotalDays < 1) { lastLoginDisplay = "Today"; }
                        else if (span.TotalDays < 2) { lastLoginDisplay = "Yesterday"; }
                        else if (span.TotalDays < 30) { lastLoginDisplay = $"{(int)span.TotalDays}d ago"; }
                        else { lastLoginDisplay = user.LastLogin.Value.ToString("MMM d, yyyy"); }
                    }

                    <div class="user-table-row"
                         data-id="@user.Id"
                         data-name="@((user.EmployeeName ?? "").ToLower())"
                         data-username="@((user.UserId ?? "").ToLower())"
                         data-email="@((user.Email ?? "").ToLower())"
                         data-department="@(user.Department ?? String.Empty)"
                         data-role="@roleClass"
                         data-status="@(user.IsActive ? "active" : "inactive")"
                         data-login-sort="@(user.LastLogin?.Ticks ?? 0)">
                        <div class="user-name-col">
                            <div class="user-avatar" style="background:@avatarColor">@initials</div>
                            <div class="user-info">
                                <div class="user-full-name">@user.EmployeeName</div>
                                <div class="user-username">@((user.UserId ?? string.Empty))</div>
                            </div>
                        </div>

                        <div class="email-col" data-label="Email">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                            <a href="mailto:@user.Email">@user.Email</a>
                        </div>

                        <div class="department-col" data-label="Department">@user.Department</div>

                        <div class="role-col" data-label="Role">
                            <span class="role-badge role-@roleClass"><span class="dot"></span>@user.Role</span>
                        </div>

                        <div class="last-login-col" data-label="Last Login">
                            @if (user.LastLogin.HasValue)
                            {
                                <span title="@lastLoginTitle">@lastLoginDisplay</span>
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </div>

                        <div class="status-col" data-label="Status">
                            @if (user.IsActive)
                            {
                                <span class="status-badge active"><span class="dot"></span>Active</span>
                            }
                            else
                            {
                                <span class="status-badge inactive"><span class="dot"></span>Inactive</span>
                            }
                        </div>

                        <div class="actions-col">
                            <!-- Edit button -->
                            <button type="button" class="action-icon edit-btn" onclick="editUser(@user.Id)" title="Edit user" aria-label="Edit user">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                            </button>

                            <form method="post" asp-page-handler="ToggleStatus" asp-route-userId="@user.Id" class="account-status-form" data-user-name="@user.EmployeeName" data-action="@(user.IsActive ? "deactivate" : "activate")" style="display:inline-block;">
                                <input type="hidden" name="isActive" value="@(user.IsActive ? "false" : "true")" />
                                <button type="submit" class="action-icon status-btn @(user.IsActive ? "" : "activate-btn")" title="@(user.IsActive ? "Deactivate user account" : "Activate user account")" aria-label="@(user.IsActive ? "Deactivate user account" : "Activate user account")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        @if (user.IsActive)
                                        {
                                            <path d="M10 9v6M14 9v6"></path>
                                        }
                                        else
                                        {
                                            <path d="m10 8 6 4-6 4z"></path>
                                        }
                                    </svg>
                                </button>
                            </form>

                            <!-- Delete button (form submit) -->
                            <form method="post" asp-page-handler="Delete" asp-route-userId="@user.Id" onsubmit="return confirm('Are you sure you want to delete this user?');" style="display:inline-block;">
                                <button type="submit" class="action-icon delete-btn" title="Delete user" aria-label="Delete user">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-table">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <div class="empty-title">No users found</div>
                    <div class="empty-desc">Try adjusting your search or filters.</div>
                </div>
            }
        </div>

        <!-- Row shown when filters/search leave nothing visible -->
        <div class="empty-state-table" id="noResultsState" style="display:none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
            <div class="empty-title">No matching users</div>
            <div class="empty-desc">Try a different search term or filter.</div>
        </div>
    </div>

    <!-- Pagination info -->
    @if (Model.Users != null && Model.Users.Count > 0)
    {
        <div class="pagination-info">
            <span id="resultsCount">Showing @Model.Users.Count of @Model.Statistics.TotalUsers users</span>
        </div>
    }
</div>

<div class="modal fade" id="accountStatusConfirmModal" tabindex="-1" aria-labelledby="accountStatusConfirmTitle" aria-describedby="accountStatusConfirmMessage" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="accountStatusConfirmTitle">Confirm account change</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="accountStatusConfirmMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAccountStatusButton">Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- Add New User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg max-w-2xl mx-auto">
        <div class="modal-content bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="modal-header flex items-center justify-between p-4 border-b">
                <div class="modal-title-section flex items-center gap-3">
                    <div class="text-indigo-600 bg-indigo-50 rounded-full p-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <h5 id="addUserModalLabel" class="text-lg font-semibold">Add New User</h5>
                </div>
                <button type="button" class="btn-close text-gray-500 hover:bg-gray-100 rounded p-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="All" class="text-danger px-6 pt-4" role="alert"></div>
                <div class="modal-body p-6 bg-gray-50">
                    <div class="modal-avatar-row flex items-center gap-4 mb-4">
                        <div class="avatar-preview w-12 h-12 rounded-full flex items-center justify-center text-white font-semibold" id="avatarPreview">?</div>
                        <div class="avatar-hint text-sm text-gray-500">Avatar initials are generated automatically from the full name.</div>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group-modal">
                        <label class="form-label">Full Name</label>
                        <div class="input-wrapper">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input type="text" class="form-control" id="fullName" name="NewUser.EmployeeName" placeholder="Enter full name" value="@(Model.NewUser?.EmployeeName ?? String.Empty)" maxlength="100" required />
                        </div>
                    </div>

                    <!-- Username and Password Row -->
                    <div class="form-row">
                        <div class="form-group-modal">
                            <label class="form-label">UserID</label>
                            <div class="input-wrapper">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <input type="text" class="form-control" id="username" name="NewUser.UserId" placeholder="Enter user ID" value="@(Model.NewUser?.UserId ?? String.Empty)" maxlength="50" required />
                            </div>
                        </div>

                        <div class="form-group-modal">
                            <label class="form-label">Password</label>
                            <div class="input-wrapper">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                <input type="password" class="form-control" id="password" name="NewUser.Password" placeholder="••••••••" maxlength="255" required autocomplete="new-password" />
                                <button type="button" class="input-action-btn" id="togglePasswordBtn" title="Show password" aria-label="Show password">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                            <div class="field-hint-row">
                                <button type="button" class="field-hint-btn" id="generatePasswordBtn">Generate password</button>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-group-modal">
                        <label class="form-label">Email</label>
                        <div class="input-wrapper">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                            <input type="email" class="form-control" id="email" name="NewUser.Email" placeholder="Enter email address" value="@(Model.NewUser?.Email ?? String.Empty)" maxlength="255" required />
                        </div>
                    </div>

                    <!-- Department -->
                    <div class="form-group-modal">
                        <label class="form-label" for="department">Department</label>
                        <div class="input-wrapper">
                            <select class="form-control" id="department" name="NewUser.Department" required>
                                <option value="">Select a department</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department" selected="@(Model.NewUser?.Department == department)">@department</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Access Level Selection -->
                    <div class="form-group-modal">
                        <label class="form-label">Access Level</label>
                        <div class="access-level-selector">
                            <div class="role-option">
                                <input type="radio" id="roleAdmin" name="NewUser.Role" value="Admin" required @(Model.NewUser?.Role == "Admin" ? "checked" : "") />
                                <label for="roleAdmin" class="role-option-label admin px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Admin" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon admin">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Admin</span>
                                        <span class="role-description">Full system access</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="roleApprover" name="NewUser.Role" value="Approver" @(Model.NewUser?.Role == "Approver" ? "checked" : "") />
                                <label for="roleApprover" class="role-option-label approver px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Approver" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon approver">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 3l8 4v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V7l8-4z"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Approver</span>
                                        <span class="role-description">Approve &amp; manage requests</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="roleEncoder" name="NewUser.Role" value="Encoder" @(Model.NewUser?.Role == "Encoder" ? "checked" : "") />
                                <label for="roleEncoder" class="role-option-label encoder px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Encoder" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon encoder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Encoder</span>
                                        <span class="role-description">Create &amp; edit records</span>
                                    </span>
                                </label>
                            </div>

                            <div class="role-option">
                                <input type="radio" id="roleViewer" name="NewUser.Role" value="Viewer" @(Model.NewUser?.Role == "Viewer" ? "checked" : "") />
                                <label for="roleViewer" class="role-option-label viewer px-3 py-2 rounded-md flex items-center gap-3 @(Model.NewUser?.Role == "Viewer" ? "ring-2 ring-indigo-300 bg-indigo-50 border border-indigo-200" : "border border-transparent")">
                                    <span class="role-icon viewer">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </span>
                                    <span class="role-text">
                                        <span class="role-name">Viewer</span>
                                        <span class="role-description">Read-only access</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Account Status -->
                    <div class="form-group-modal account-status">
                        <div>
                            <div class="form-label">Account Status</div>
                            <div class="status-hint">New users are created as active by default.</div>
                        </div>
                        <div class="status-toggle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <input type="checkbox" id="addIsActive" name="NewUser.IsActive" value="true" @(Model.NewUser?.IsActive == true ? "checked" : "") />
                            <input type="hidden" name="NewUser.IsActive" value="false" />
                            <span class="toggle-label">Active</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer flex items-center justify-end gap-3 p-4 border-t bg-white">
                    <button type="button" data-bs-dismiss="modal" class="bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-md">Cancel</button>
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-md">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side: highlight selected role option labels in add/edit modals
        function setupRoleOptionHighlighting(containerSelector) {
            var container = document.querySelector(containerSelector);
            if (!container) return;
            var inputs = container.querySelectorAll('input[type=radio][name="NewUser.Role"]');
            inputs.forEach(function (input) {
                var label = container.querySelector('label[for="' + input.id + '"]');
                if (!label) return;
                // initialize - apply tailwind highlight classes
                if (input.checked) {
                    label.classList.add('ring-2','ring-indigo-300','bg-indigo-50','border','border-indigo-200');
                } else {
                    label.classList.remove('ring-2','ring-indigo-300','bg-indigo-50','border','border-indigo-200');
                }
                input.addEventListener('change', function () {
                    inputs.forEach(function (i) {
                        var l = container.querySelector('label[for="' + i.id + '"]'); if (l) l.classList.remove('ring-2','ring-indigo-300','bg-indigo-50','border','border-indigo-200');
                    });
                    if (input.checked) label.classList.add('ring-2','ring-indigo-300','bg-indigo-50','border','border-indigo-200');
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var statusConfirmationModal = document.getElementById('accountStatusConfirmModal');
            var statusConfirmationMessage = document.getElementById('accountStatusConfirmMessage');
            var confirmStatusButton = document.getElementById('confirmAccountStatusButton');
            var pendingStatusForm = null;

            var editActiveCheckbox = document.getElementById('editIsActive');
            var editActiveLabel = document.getElementById('editIsActiveLabel');
            editActiveCheckbox.addEventListener('change', function () {
                editActiveLabel.textContent = editActiveCheckbox.checked ? 'Active' : 'Inactive';
            });

            document.querySelectorAll('.account-status-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.dataset.confirmed === 'true') {
                        delete form.dataset.confirmed;
                        return;
                    }

                    event.preventDefault();
                    pendingStatusForm = form;
                    var action = form.dataset.action;
                    var userName = form.dataset.userName || 'this user';
                    statusConfirmationMessage.textContent = action === 'deactivate'
                        ? 'Deactivate ' + userName + "'s account? They will no longer be able to sign in."
                        : 'Reactivate ' + userName + "'s account? They will be able to sign in again.";
                    bootstrap.Modal.getOrCreateInstance(statusConfirmationModal).show();
                });
            });

            confirmStatusButton.addEventListener('click', function () {
                if (!pendingStatusForm) return;

                var form = pendingStatusForm;
                pendingStatusForm = null;
                form.dataset.confirmed = 'true';
                bootstrap.Modal.getOrCreateInstance(statusConfirmationModal).hide();
                form.requestSubmit();
            });

            statusConfirmationModal.addEventListener('hidden.bs.modal', function () {
                pendingStatusForm = null;
            });

            document.querySelectorAll('.alert-success').forEach(function (alert) {
                window.setTimeout(function () {
                    if (alert.isConnected) {
                        bootstrap.Alert.getOrCreateInstance(alert).close();
                    }
                }, 2500);
            });

            setupRoleOptionHighlighting('#addUserModal');
            setupRoleOptionHighlighting('#editUserModal');

            // Open modals if server requested due to validation errors
            var openAdd = @(ViewData["OpenAddModal"] != null ? "true" : "false");
            var openEdit = @(ViewData["OpenEditModal"] != null ? "true" : "false");
            var editUserId = '@(ViewData["EditUserId"] ?? String.Empty)';
            if (openAdd === true || openAdd === 'true') {
                var modalEl = document.getElementById('addUserModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }
            if (openEdit === true || openEdit === 'true') {
                // If server provided EditUserId, try to ensure correct form values are used (Model.NewUser binds values)
                var modalEl = document.getElementById('editUserModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }
        });

        function editUser(userId) {
            try {
                var row = document.querySelector('.user-table-row[data-id="' + userId + '"]');
                if (!row) {
                    alert('User row not found');
                    return;
                }

                // Read displayed values from the row to keep original casing
                var displayNameEl = row.querySelector('.user-full-name');
                var displayUsernameEl = row.querySelector('.user-username');
                var emailEl = row.querySelector('.email-col a');
                var roleEl = row.querySelector('.role-col .role-badge');
                var department = row.dataset.department || '';
                var status = row.dataset.status || 'inactive';

                var displayName = displayNameEl ? displayNameEl.textContent.trim() : '';
                var displayUsername = displayUsernameEl ? displayUsernameEl.textContent.trim() : '';
                var email = emailEl ? emailEl.textContent.trim() : '';
                var role = roleEl ? roleEl.textContent.trim() : '';

                // Populate form fields
                document.getElementById('editUserId').value = userId;
                document.getElementById('editEmployeeName').value = displayName;
                document.getElementById('editUserUserId').value = displayUsername;
                document.getElementById('editEmail').value = email;
                document.getElementById('editDepartment').value = department;
                document.getElementById('editPassword').value = '';

                // Set role radio (match by trimmed, case-insensitive value)
                var roleInputs = document.querySelectorAll('#editUserForm input[name="NewUser.Role"]');
                roleInputs.forEach(function (r) {
                    if (r.value.trim().toLowerCase() === (role || '').trim().toLowerCase()) r.checked = true; else r.checked = false;
                });

                // Set active checkbox and matching status label
                var isActiveCheckbox = document.getElementById('editIsActive');
                isActiveCheckbox.checked = (status === 'active');
                document.getElementById('editIsActiveLabel').textContent = isActiveCheckbox.checked ? 'Active' : 'Inactive';

                // Show modal
                var modalEl = document.getElementById('editUserModal');
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            } catch (ex) {
                console.error(ex);
                alert('Unable to open edit modal.');
            }
        }

        (function () {
            var rows = Array.prototype.slice.call(document.querySelectorAll('.user-table-row'));
            var searchInput = document.getElementById('searchInput');
            var statusPills = document.querySelectorAll('.status-pill');
            var roleFilter = document.getElementById('roleFilter');
            var noResultsState = document.getElementById('noResultsState');
            var resultsCount = document.getElementById('resultsCount');
            var totalUsers = @Model.Statistics.TotalUsers;

            var state = { query: '', status: 'all', role: 'all' };
            var sortState = { key: null, dir: 1 };

            function applyFilters() {
                var visible = 0;
                rows.forEach(function (row) {
                    var matchesQuery = !state.query ||
                        row.dataset.name.indexOf(state.query) !== -1 ||
                        row.dataset.email.indexOf(state.query) !== -1 ||
                        row.dataset.username.indexOf(state.query) !== -1 ||
                        row.dataset.department.toLowerCase().indexOf(state.query) !== -1;
                    var matchesStatus = state.status === 'all' || row.dataset.status === state.status;
                    var matchesRole = state.role === 'all' || row.dataset.role === state.role;

                    var show = matchesQuery && matchesStatus && matchesRole;
                    row.classList.toggle('row-hidden', !show);
                    if (show) visible++;
                });

                if (noResultsState) {
                    noResultsState.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
                }
                if (resultsCount) {
                    resultsCount.textContent = 'Showing ' + visible + ' of ' + totalUsers + ' users';
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    state.query = this.value.trim().toLowerCase();
                    applyFilters();
                });
            }

            statusPills.forEach(function (pill) {
                pill.addEventListener('click', function () {
                    statusPills.forEach(function (p) { p.classList.remove('active'); });
                    this.classList.add('active');
                    state.status = this.dataset.status;
                    applyFilters();
                });
            });

            var accessLevelCards = document.querySelectorAll('.access-level-card[data-access-role]');

            function selectRole(role) {
                state.role = role;
                if (roleFilter) roleFilter.value = role;

                accessLevelCards.forEach(function (card) {
                    var isSelected = card.dataset.accessRole === role;
                    card.classList.toggle('is-selected', isSelected);
                    card.setAttribute('aria-pressed', String(isSelected));
                });

                applyFilters();
            }

            if (roleFilter) {
                roleFilter.addEventListener('change', function () {
                    selectRole(this.value);
                });
            }

            accessLevelCards.forEach(function (card) {
                function toggleRoleFilter() {
                    selectRole(state.role === card.dataset.accessRole ? 'all' : card.dataset.accessRole);
                }

                card.addEventListener('click', toggleRoleFilter);
                card.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        toggleRoleFilter();
                    }
                });
            });

            // Sorting
            var tableBody = document.querySelector('.users-table-scroll');
            document.querySelectorAll('.th-btn[data-sort]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var key = this.dataset.sort;
                    if (sortState.key === key) {
                        sortState.dir *= -1;
                    } else {
                        sortState.key = key;
                        sortState.dir = 1;
                    }

                    document.querySelectorAll('.th-btn[data-sort]').forEach(function (b) {
                        b.classList.remove('sort-asc', 'sort-desc');
                    });
                    this.classList.add(sortState.dir === 1 ? 'sort-asc' : 'sort-desc');

                    var sorted = rows.slice().sort(function (a, b) {
                        var av, bv;
                        switch (key) {
                            case 'name': av = a.dataset.name; bv = b.dataset.name; break;
                            case 'email': av = a.dataset.email; bv = b.dataset.email; break;
                            case 'department': av = a.dataset.department.toLowerCase(); bv = b.dataset.department.toLowerCase(); break;
                            case 'role': av = a.dataset.role; bv = b.dataset.role; break;
                            case 'status': av = a.dataset.status; bv = b.dataset.status; break;
                            case 'login': av = parseInt(a.dataset.loginSort, 10); bv = parseInt(b.dataset.loginSort, 10); break;
                            default: av = ''; bv = '';
                        }
                        if (av < bv) return -1 * sortState.dir;
                        if (av > bv) return 1 * sortState.dir;
                        return 0;
                    });

                    sorted.forEach(function (row) { tableBody.appendChild(row); });
                });
            });

            // Export visible rows to CSV
            var exportBtn = document.getElementById('exportCsvBtn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function () {
                    var visibleRows = rows.filter(function (r) { return !r.classList.contains('row-hidden'); });
                    var lines = [['Name', 'Username', 'Email', 'Department', 'Role', 'Status'].join(',')];
                    visibleRows.forEach(function (row) {
                        var name = row.querySelector('.user-full-name').textContent.trim();
                        var username = row.dataset.username;
                        var email = row.dataset.email;
                        var department = row.dataset.department;
                        var role = row.dataset.role;
                        var status = row.dataset.status;
                        var esc = function (v) { return '"' + String(v).replace(/"/g, '""') + '"'; };
                        lines.push([esc(name), esc(username), esc(email), esc(department), esc(role), esc(status)].join(','));
                    });
                    var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'users.csv';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                });
            }
        })();

        // Modal helpers: live avatar preview, password show/hide, generate password
        (function () {
            var fullNameInput = document.getElementById('fullName');
            var avatarPreview = document.getElementById('avatarPreview');
            if (fullNameInput && avatarPreview) {
                fullNameInput.addEventListener('input', function () {
                    var parts = this.value.trim().split(/\s+/).filter(Boolean);
                    var initials = parts.slice(0, 2).map(function (p) { return p[0].toUpperCase(); }).join('');
                    avatarPreview.textContent = initials || '?';
                });
            }

            var passwordInput = document.getElementById('password');
            var toggleBtn = document.getElementById('togglePasswordBtn');
            if (passwordInput && toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    var showing = passwordInput.type === 'text';
                    passwordInput.type = showing ? 'password' : 'text';
                    this.title = showing ? 'Show password' : 'Hide password';
                });
            }

            var generateBtn = document.getElementById('generatePasswordBtn');
            if (generateBtn && passwordInput) {
                generateBtn.addEventListener('click', function () {
                    var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@##$$%%';
                    var value = '';
                    for (var i = 0; i < 12; i++) {
                        value += chars.charAt(Math.floor(Math.random() * chars.length));
                    }
                    passwordInput.type = 'text';
                    passwordInput.value = value;
                    if (toggleBtn) toggleBtn.title = 'Hide password';
                });
            }
        })();
    </script>
}
