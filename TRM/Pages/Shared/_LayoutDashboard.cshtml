@* @{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tool Request Management System Dashboard" />
    <meta name="theme-color" content="#2E5F8A" />
    <title>TRM Dashboard</title>

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/img/PTI_nb.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Sidebar Navigation -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="app-logo">
                    <span class="logo-icon">🔧</span>
                    <div class="logo-content">
                        <span class="logo-text">ToolingApp</span>
                        <span class="logo-subtitle">PRIMEPACK</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-menu">
                <a href="/" class="menu-item active">
                    <span class="menu-icon">📋</span>
                    <span class="menu-text">Tooling Requests</span>
                </a>
                <a href="/Prerequisites" class="menu-item">
                    <span class="menu-icon">⚙️</span>
                    <span class="menu-text">Prerequisites</span>
                </a>
            </div>

            <div class="sidebar-footer">
                <div class="user-info">
                    <div class="user-avatar">👤</div>
                    <div class="user-details">
                        <div class="user-name" id="userName">@(Context.Session.GetString("EmployeeName") ?? "User")</div>
                        <div class="user-id" id="userId">@(Context.Session.GetString("Username") ?? "PTI-26-0000")</div>
                        <div class="user-email" id="userEmail">@(Context.Session.GetString("Email") ?? "user@company.com")</div>
                    </div>
                </div>
                <a href="/Auth/Logout" class="sign-out-btn">Sign Out</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="dashboard-header">
                <div class="header-content">
                    <h1>Tooling Requests</h1>
                    <p>Manage all existing tooling requests or create a new one.</p>
                </div>
                <button class="btn btn-primary btn-new-request">
                    <span>+ New Request</span>
                </button>
            </header>

            <!-- Content Area -->
            <div class="dashboard-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // New Request button handler
        document.querySelector('.btn-new-request')?.addEventListener('click', function() {
            // Navigate to create new request
            window.location.href = '/ToolingRequest/Create';
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
 *@


@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tool Request Management System Dashboard" />
    <meta name="theme-color" content="#1C1F24" />
    <title>@ViewData["Title"] - TRM</title>

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/img/PTI_nb.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Sidebar Navigation -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="app-logo">
                    <span class="logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#1C1F24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                        </svg>
                    </span>
                    <div class="logo-content">
                        <span class="logo-text">ToolCrib</span>
                        <span class="logo-subtitle">PRIMEPACK</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-menu">
                <a href="/" class="menu-item @(ViewData["Active"] as string == "requests" ? "active" : "")">
                    <span class="menu-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/>
                            <path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/>
                            <path d="M9 12h6M9 16h6"/>
                        </svg>
                    </span>
                    <span class="menu-text">Tooling Requests</span>
                </a>
                <a href="/Prerequisites" class="menu-item @(ViewData["Active"] as string == "prereqs" ? "active" : "")">
                    <span class="menu-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </span>
                    <span class="menu-text">Prerequisites</span>
                </a>
            </div>

            <div class="sidebar-footer">
                <div class="user-info">
                    <div class="user-avatar">@(((Context.Session.GetString("EmployeeName") ?? "U A")).Split(' ').Where(s => s.Length > 0).Select(s => s[0]).Take(2).Aggregate("", (a,b) => a + b))</div>
                    <div class="user-details">
                        <div class="user-name">@(Context.Session.GetString("EmployeeName") ?? "User")</div>
                        <div class="user-id">@(Context.Session.GetString("Username") ?? "PTI-26-0000")</div>
                    </div>
                </div>
                <a href="/Auth/Logout" class="sign-out-btn">Sign Out</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
