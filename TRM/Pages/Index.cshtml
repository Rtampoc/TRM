@*@page
@model TRM.Pages.IndexModel
@{
    ViewData["Title"] = "Tooling Requests";
    Layout = "~/Pages/Shared/_LayoutDashboard.cshtml";
}

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>TRF No.</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Date Requested</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.ToolingRequests?.Count > 0)
            {
                @foreach (var request in Model.ToolingRequests)
                {
                    <tr>
                        <td>
                            <a href="/ToolingRequest/Detail?id=@request.Id" class="table-link">
                                @request.RequestNumber
                            </a>
                        </td>
                        <td>@request.CustomerName</td>
                        <td>
                            <span class="badge" style="@GetStatusStyle(request.Status)">
                                @request.Status
                            </span>
                        </td>
                        <td>@request.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">
                        <div class="empty-state" style="padding: 40px 20px;">
                            <div class="empty-state-icon">📋</div>
                            <h2>No Tooling Requests</h2>
                            <p>You haven't created any tooling requests yet. Get started by creating a new request.</p>
                            <a href="/ToolingRequest/Create" class="btn btn-primary">+ Create New Request</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Load user info display
        document.addEventListener('DOMContentLoaded', function() {
            const userNameEl = document.getElementById('userName');
            const userEmailEl = document.getElementById('userEmail');

            if (userNameEl && '@Model.UserName' !== '') {
                userNameEl.textContent = '@Model.UserName';
            }

            if (userEmailEl && '@Model.UserEmail' !== '') {
                userEmailEl.textContent = '@Model.UserEmail';
            }
        });
    </script>
}

@functions {
    private string GetStatusStyle(string status)
    {
        return status switch
        {
            "Draft" => "background-color: #FEF3C7; color: #92400E;",
            "Submitted" => "background-color: #D1FAE5; color: #047857;",
            "Approved" => "background-color: #DBEAFE; color: #1E40AF;",
            "Pending" => "background-color: #E0E7FF; color: #3730A3;",
            _ => ""
        };
    }
}*@


@page
@model TRM.Pages.IndexModel
@{
    ViewData["Title"] = "Tooling Requests";
    ViewData["Active"] = "requests";
    Layout = "~/Pages/Shared/_LayoutDashboard.cshtml";
}

<header class="dashboard-header">
    <div class="header-content">
        <h1>Tooling Requests</h1>
        <p>Manage all existing tooling requests or create a new one.</p>
    </div>
    <a href="/ToolingRequest/Create" class="btn-new-request">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        New Request
    </a>
</header>

<div class="dashboard-content">
    <div class="tag-list-header">
        <span></span>
        <span>TRF No.</span>
        <span>Customer</span>
        <span>Date Requested</span>
        <span>Status</span>
    </div>

    <div class="tag-list">
        @* Replace this loop with @foreach (var r in Model.Requests) using your real data *@
        <a href="/ToolingRequest/TRF-2026-001" class="tool-tag" data-status="draft">
            <div class="tag-rivet"></div>
            <div class="tag-number">TRF-2026-001</div>
            <div class="tag-customer">
                <div class="tag-customer-name">3C Signature Asian Group Corp</div>
                <div class="tag-customer-label">Customer</div>
            </div>
            <div class="tag-date">2026-01-13</div>
            <div class="tag-status-cell"><span class="stamp draft">Draft</span></div>
        </a>

        <a href="/ToolingRequest/TRF-2026-002" class="tool-tag" data-status="submitted">
            <div class="tag-rivet"></div>
            <div class="tag-number">TRF-2026-002</div>
            <div class="tag-customer">
                <div class="tag-customer-name">TechCorp Manufacturing</div>
                <div class="tag-customer-label">Customer</div>
            </div>
            <div class="tag-date">2026-01-14</div>
            <div class="tag-status-cell"><span class="stamp submitted">Submitted</span></div>
        </a>
    </div>
</div>

