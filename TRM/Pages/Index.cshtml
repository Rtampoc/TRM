@page
@model TRM.Pages.IndexModel
@{
    ViewData["Title"] = "Tooling Requests";
    ViewData["Active"] = "requests";
    Layout = "~/Pages/Shared/_LayoutDashboard.cshtml";
}

<header class="dashboard-header">
    <div class="header-content">
        <h1>Tooling Requests</h1>
        <p>Manage all existing tooling requests or create a new one.</p>
    </div>
    <a href="/ToolingRequest/Create" class="btn-new-request">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        New Request
    </a>
</header>

<div class="dashboard-content">
    @if (Model.ToolingRequests?.Count > 0)
    {
        <div class="tag-list-header">
            <span></span>
            <span>TRF No.</span>
            <span>Customer</span>
            <span>Date Requested</span>
            <span>Status</span>
        </div>

        <div class="tag-list">
            @foreach (var request in Model.ToolingRequests)
            {
                var statusKey = request.Status.ToLower();
                <a href="/ToolingRequest/Detail?id=@request.Id" class="tool-tag" data-status="@statusKey">
                    <div class="tag-rivet"></div>
                    <div class="tag-number">@request.RequestNumber</div>
                    <div class="tag-customer">
                        <div class="tag-customer-name">@request.CustomerName</div>
                        <div class="tag-customer-label">Customer</div>
                    </div>
                    <div class="tag-date">@request.CreatedDate.ToString("yyyy-MM-dd")</div>
                    <div class="tag-status-cell"><span class="stamp @statusKey">@request.Status</span></div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <h2>No Tooling Requests</h2>
            <p>You haven't created any tooling requests yet. Get started by creating a new request.</p>
            <a href="/ToolingRequest/Create" class="btn-new-request">+ Create New Request</a>
        </div>
    }
</div>
