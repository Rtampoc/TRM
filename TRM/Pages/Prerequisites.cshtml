@page
@model TRM.Pages.PrerequisitesModel
@{
    ViewData["Title"] = "Prerequisites";
    ViewData["Active"] = "prereqs";
    Layout = "~/Pages/Shared/_LayoutDashboard.cshtml";
}

<header class="dashboard-header">
    <div class="header-content">
        <h1>Prerequisites Management</h1>
        <p>Select a category below to manage its records.</p>
    </div>
</header>

<div class="dashboard-content">
    <div class="category-grid">
        <div class="category-card active" tabindex="0" data-category="customers">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="category-title">Customers</div>
            <div class="category-count">2 Records</div>
        </div>

        <div class="category-card" tabindex="0" data-category="tooltypes">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <div class="category-title">Tool Types</div>
            <div class="category-count">2 Records</div>
        </div>

        <div class="category-card" tabindex="0" data-category="category">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </div>
            <div class="category-title">Category</div>
            <div class="category-count">2 Records</div>
        </div>

        <div class="category-card" tabindex="0" data-category="reasons">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            </div>
            <div class="category-title">Reasons for Revision</div>
            <div class="category-count">2 Records</div>
        </div>

        <div class="category-card" tabindex="0" data-category="notedby">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="category-title">Noted By</div>
            <div class="category-count">2 Records</div>
        </div>

        <div class="category-card" tabindex="0" data-category="registeredby">
            <div class="category-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="category-title">Registered By</div>
            <div class="category-count">2 Records</div>
        </div>
    </div>

    <div class="record-panel">
        <div class="record-panel-header">
            <h2>Customers List</h2>
            <button class="btn-add">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Add Customer
            </button>
        </div>
        <table class="record-table">
            <thead>
                <tr>
                    <th>BP Code</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Added Date</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Replace with @foreach (var c in Model.Customers) using your real data *@
                <tr>
                    <td class="mono">BP-0231</td>
                    <td>3C Signature Asian Group Corp</td>
                    <td><span class="status-chip active">Active</span></td>
                    <td class="mono">2025-10-12</td>
                    <td>
                        <div class="row-actions">
                            <button class="icon-btn" title="Edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                            <button class="icon-btn danger" title="Delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg></button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="mono">BP-0198</td>
                    <td>TechCorp Manufacturing</td>
                    <td><span class="status-chip active">Active</span></td>
                    <td class="mono">2025-11-05</td>
                    <td>
                        <div class="row-actions">
                            <button class="icon-btn" title="Edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                            <button class="icon-btn danger" title="Delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // Swap the active category card and reload the record panel for that category.
    // Wire the fetch/AJAX call to your Prerequisites page handler as needed.
    document.querySelectorAll('.category-card').forEach(card => {
        card.addEventListener('click', () => {
            document.querySelector('.category-card.active')?.classList.remove('active');
            card.classList.add('active');
        });
        card.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') card.click();
        });
    });
</script>
}
